# PKGBUILD template for AUR / local Arch builds.
# Upstream does not maintain the AUR package itself; users may copy this file
# to a directory named cronjob-manager and run `makepkg -si`.
# Update pkgver/sha256sums when packaging a new release.

pkgname=cronjob-manager
pkgver=0.1.0
pkgrel=1
pkgdesc="Desktop GUI application for managing user and system cron jobs on Linux"
arch=('x86_64')
url="https://github.com/yikuide-lab/cronjob-manager"
license=('MIT')
depends=('gcc-libs' 'libxkbcommon' 'wayland' 'libxcb')
makedepends=('cargo')
source=("${url}/archive/v${pkgver}/${pkgname}-${pkgver}.tar.gz")
sha256sums=('SKIP')

prepare() {
    cd "${pkgname}-${pkgver}"
    export CARGO_HOME="${SRCDEST:-$startdir}/cargo-home"
    cargo fetch --locked --target "$(uname -m)-unknown-linux-gnu"
}

build() {
    cd "${pkgname}-${pkgver}"
    export CARGO_TARGET_DIR=target
    cargo build --release --frozen
}

package() {
    cd "${pkgname}-${pkgver}"
    install -Dm755 target/release/cronjob-manager -t "${pkgdir}/usr/bin"
    install -Dm644 README.md -t "${pkgdir}/usr/share/doc/${pkgname}"
    install -Dm644 LICENSE -t "${pkgdir}/usr/share/licenses/${pkgname}"
}
